{
  "name": "@danxcode/node-md",
  "version": "0.2.0",
  "description": "Low-overhead Node.js process benchmark metrics",
  "keywords": [
    "nodejs",
    "performance",
    "monitoring",
    "event-loop",
    "metrics",
    "prometheus"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanLivassan/doctor-md.git"
  },
  "bugs": {
    "url": "https://github.com/DanLivassan/doctor-md/issues"
  },
  "homepage": "https://github.com/DanLivassan/doctor-md#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./prometheus": {
      "types": "./dist/exporters/prometheus.d.ts",
      "import": "./dist/exporters/prometheus.js",
      "require": "./dist/exporters/prometheus.cjs"
    },
    "./http": {
      "types": "./dist/exporters/http-handler.d.ts",
      "import": "./dist/exporters/http-handler.js",
      "require": "./dist/exporters/http-handler.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts src/exporters/prometheus.ts src/exporters/http-handler.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "test:overhead": "vitest run test/overhead.test.ts",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "benchmark:overhead": "npm run build && node benchmarks/overhead.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:integration",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.0"
  }
}
